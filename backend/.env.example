# Copie para backend/.env e ajuste. Todas as variáveis são opcionais.

# Cadastros e eventos (servidores, gatilhos, alertas, relatórios)
# padrão: backend/smi.db (o mesmo de qualquer pasta onde o comando for executado)
# SMI_DATABASE_URL=sqlite:///C:/caminho/para/smi.db

# Séries temporais: sqlite (padrão, sem instalar nada) ou influx
SMI_METRICS_BACKEND=sqlite
SMI_INFLUX_URL=http://localhost:8086
SMI_INFLUX_TOKEN=
SMI_INFLUX_ORG=smi
SMI_INFLUX_BUCKET=metrics

# Token que os coletores enviam no cabeçalho X-Ingest-Token
SMI_INGEST_TOKEN=dev-token

# Sem leituras há mais que isso, o host fica "unknown" (3 ciclos de 15 s)
SMI_STALE_AFTER_SECONDS=45

# ---------- Assistente de IA (etapa 4) ----------
# ollama (padrão, local e gratuito) | anthropic (Claude, pago por uso) | none (desligado)
SMI_LLM_PROVIDER=ollama
# vazio = padrão do provedor: qwen2.5:7b (Ollama) ou claude-opus-5-5 (Anthropic)
SMI_LLM_MODEL=
SMI_OLLAMA_URL=http://127.0.0.1:11434

# Só para SMI_LLM_PROVIDER=anthropic (crie a chave em console.anthropic.com)
SMI_ANTHROPIC_API_KEY=
SMI_ANTHROPIC_EFFORT=medium

# Endereço da API que o servidor MCP consulta (mude se a API rodar em outra porta)
SMI_MCP_API_URL=http://127.0.0.1:8000/api/v1
