# Copie para backend/.env e ajuste. Todas as variáveis são opcionais.

# Cadastros e eventos (servidores, gatilhos, alertas, relatórios)
SMI_DATABASE_URL=sqlite:///./smi.db

# Séries temporais: sqlite (padrão, sem instalar nada) ou influx
SMI_METRICS_BACKEND=sqlite
SMI_INFLUX_URL=http://localhost:8086
SMI_INFLUX_TOKEN=
SMI_INFLUX_ORG=smi
SMI_INFLUX_BUCKET=metrics

# Token que os coletores enviam no cabeçalho X-Ingest-Token
SMI_INGEST_TOKEN=dev-token

# Sem leituras há mais que isso, o host fica "unknown" (3 ciclos de 15 s)
SMI_STALE_AFTER_SECONDS=45
