# Configuração do agente do SMI (no servidor: /etc/smi-agent/agent.env, permissão 600)

# API do SMI, pelo IP do PC na rede Tailscale (veja com: tailscale ip -4, no PC)
SMI_API_URL=http://100.x.y.z:8000/api/v1

# O mesmo valor de SMI_INGEST_TOKEN do backend/.env do PC
SMI_INGEST_TOKEN=cole-aqui-o-token

# Id do servidor cadastrado no painel do SMI (Servidores > Cadastrar servidor)
SMI_HOST_ID=vps-hostinger

# Segundos entre coletas (padrão 15, o mesmo do restante do sistema)
SMI_INTERVAL=15
